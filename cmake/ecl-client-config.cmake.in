@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(CURL 7.62)
find_dependency(OpenSSL COMPONENTS Crypto)
include("${CMAKE_CURRENT_LIST_DIR}/ecl-client-targets.cmake")

# A static ecl library exposes a C ABI but is implemented in C++. Activate the
# C++ linker for otherwise C-only consumers so the C++ runtime is linked.
get_target_property(_ECL_LIBRARY_TYPE ECL::ecl TYPE)
if(_ECL_LIBRARY_TYPE STREQUAL "STATIC_LIBRARY" AND NOT CMAKE_CXX_COMPILER_LOADED)
    enable_language(CXX)
endif()
unset(_ECL_LIBRARY_TYPE)
